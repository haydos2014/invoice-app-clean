generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BookingStatus {
  DRAFT
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
}

model Client {
  id        String    @id @default(cuid())
  name      String
  org       String?
  email     String?
  phone     String?
  address   String?
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  bookings  Booking[]
  invoices  Invoice[]
}

model Service {
  id              String    @id @default(cuid())
  label           String
  defaultDuration Int
  defaultPrice    Int
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  bookings        Booking[]
}

model Booking {
  id        String        @id @default(cuid())
  clientId  String
  serviceId String
  date      DateTime
  startTime String
  duration  Int
  price     Int
  notes     String?
  status    BookingStatus @default(CONFIRMED)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  client    Client        @relation(fields: [clientId], references: [id])
  service   Service       @relation(fields: [serviceId], references: [id])
  lines     InvoiceLine[]
}

model Invoice {
  id            String        @id @default(cuid())
  clientId      String
  invoiceNumber String
  periodStart   DateTime
  periodEnd     DateTime
  status        InvoiceStatus @default(DRAFT)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  client        Client        @relation(fields: [clientId], references: [id])
  lines         InvoiceLine[]
}

model InvoiceLine {
  id        String   @id @default(cuid())
  invoiceId String
  bookingId String?
  label     String
  date      DateTime
  time      String
  duration  Int
  notes     String?
  amount    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  invoice   Invoice  @relation(fields: [invoiceId], references: [id])
  booking   Booking? @relation(fields: [bookingId], references: [id])
}
